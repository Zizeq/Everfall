{
  "name": "everfallvn",
  "version": "1.0.0",
  "description": "Everfall: A Visual Novel",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "electron": "^36.4.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.everfall.vn.zizeq",
    "productName": "Everfall",
    "copyright": "Copyright © 2025 Your Name",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!**/*.zip"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "mac": {
      "category": "public.app-category.games",
      "target": "dmg",
      "icon": "build/icon.icns"
    },
    "linux": {
      "target": "AppImage",
      "icon": "build/icon.png"
    }
  }
}